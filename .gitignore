# Quartus build artefacts — regenerated by `quartus_sh --flow compile SYS80`.
# Never commit these: they are large, binary, and machine-specific.
db/
incremental_db/
output_files/
atom_netlists/
greybox_tmp/
simulation/
*.qws
*.rpt
*.summary
*.smsg
*.pin
*.sof
*.pof
*.rbf
*.jic
*.svf
*.jdi
*.done
*.qarlog
*.bak
*.bak_*
*.orig
c5_pin_model_dump.txt
PLLJ_PLLSPE_INFO.txt

# GHDL simulation work dirs
sim/*/
sim/work-obj*.cf
*.ghw
*.o

# Never commit game ROMs or dumps — copyrighted, customer-supplied.
*.bin
*.img
*.rom
*.zip

# Build logs and the ad-hoc backup copies made before each experiment.
# Git is the history now — these were the stand-in for it.
*.log
*.bak*
*.GOOD_*
*.realfix
*.orig
sim/*/
work-obj*.cf

# Released artefacts.  build.sh writes <repo>/artifacts/<tag>/ : the bitstreams
# (too large and binary for git) plus MANIFEST.txt and SHA256SUMS.  The
# provenance is NOT lost by ignoring them -- the full manifest is stored in the
# annotated release tag, so `git show fpga-v1.0.0` prints the sha256 of every
# artefact together with the commit it was built from.
artifacts/

# Retired experiment leftovers, moved here during the v1 freeze (2026-07-30):
# the ad-hoc per-experiment build_*.sh, their logs, the *.bak_* source copies,
# and the ~25 pre-v1 bitstreams that were built by hand and have no manifest.
# Nothing is deleted -- git holds the source history, this holds the rest.
attic_experiments/

# Copies de travail : quel fichier fait foi doit rester sans ambiguite.
attic_bench_*/
