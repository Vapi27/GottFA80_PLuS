#------------------------------------------------------------------------------
# P4 — bord GAUCHE du boitier = banque 2  (17 signaux)
#   P4 est en (25,14 ; 26,41), a gauche. Numerotation P4.3 en haut -> P4.24 en bas,
#   broches 40 (haut) -> 67 (bas) : meme sens, aucun croisement.
#   La broche 47 (RDWR_B) est volontairement sautee - voir AFFECTATION.md.
#------------------------------------------------------------------------------
NET "LED_ON"                    LOC = "P40"   | IOSTANDARD = LVCMOS33;   # P4.3      IO_L64N_D9_2  (bq 2)
NET "Audio_RX"                  LOC = "P41"   | IOSTANDARD = LVCMOS33;   # P4.4      IO_L64P_D8_2  (bq 2)
NET "LED_SDcard"                LOC = "P43"   | IOSTANDARD = LVCMOS33;   # P4.5      IO_L62N_D6_2  (bq 2)
NET "Sound"                     LOC = "P44"   | IOSTANDARD = LVCMOS33;   # P4.6      IO_L62P_D5_2  (bq 2)
NET "LED_Int"                   LOC = "P45"   | IOSTANDARD = LVCMOS33;   # P4.7      IO_L49N_D4_2  (bq 2)
NET "Debug"                     LOC = "P46"   | IOSTANDARD = LVCMOS33;   # P4.11     IO_L49P_D3_2  (bq 2)
NET "DIP_Return<0>"             LOC = "P48"   | IOSTANDARD = LVCMOS33;   # P4.12     IO_L48P_D7_2  (bq 2)
NET "DIP_Return<2>"             LOC = "P50"   | IOSTANDARD = LVCMOS33;   # P4.13     IO_L31N_GCLK30_D15_2  (bq 2)
NET "DIP_Return<1>"             LOC = "P55"   | IOSTANDARD = LVCMOS33;   # P4.14     IO_L30N_GCLK0_USERCCLK_2  (bq 2)
NET "CS_SDcard"                 LOC = "P56"   | IOSTANDARD = LVCMOS33;   # P4.15     IO_L30P_GCLK1_D13_2  (bq 2)
NET "DIP_Strobe<3>"             LOC = "P57"   | IOSTANDARD = LVCMOS33;   # P4.16     IO_L14N_D12_2  (bq 2)
NET "DIP_Strobe<2>"             LOC = "P58"   | IOSTANDARD = LVCMOS33;   # P4.17     IO_L14P_D11_2  (bq 2)
NET "DIP_Strobe<1>"             LOC = "P59"   | IOSTANDARD = LVCMOS33;   # P4.18     IO_L13N_D10_2  (bq 2)
NET "CS_EEprom"                 LOC = "P61"   | IOSTANDARD = LVCMOS33;   # P4.21     IO_L12N_D2_MISO3_2  (bq 2)
NET "MISO"                      LOC = "P62"   | IOSTANDARD = LVCMOS33;   # P4.22     IO_L12P_D1_MISO2_2  (bq 2)
NET "MOSI"                      LOC = "P66"   | IOSTANDARD = LVCMOS33;   # P4.23     IO_L2N_CMPMOSI_2  (bq 2)
NET "CLK"                       LOC = "P67"   | IOSTANDARD = LVCMOS33;   # P4.24     IO_L2P_CMPCLK_2  (bq 2)

#------------------------------------------------------------------------------
# SIGNAUX INTERNES — non cables sur P1..P4  (6 signaux)
#   clk_50 vient de l'oscillateur (a placer face a la broche 51) ; les 4 CFG_* vont a
#   la flash de configuration ; NOR_CS_FPGA va a la NOR partagee avec l'ESP32 et sort
#   en 35, extremite gauche du bord haut, cote tiers libre ou vit la NOR.
#------------------------------------------------------------------------------
NET "clk_50"                    LOC = "P51"   | IOSTANDARD = LVCMOS33;   # interne   IO_L31P_GCLK31_D14_2  (bq 2)
NET "NOR_CS_FPGA"               LOC = "P35"   | IOSTANDARD = LVCMOS33;   # interne   IO_L1P_3  (bq 3)
NET "esp_link_tx"               LOC = "P142"  | IOSTANDARD = LVCMOS33;   # interne   beacon jeu/FP -> ESP GPIO18 (UART1 RX)

#------------------------------------------------------------------------------
# BROCHES VOLONTAIREMENT NON AFFECTEES
#------------------------------------------------------------------------------
# Straps de mode — a cabler en dur sur le PCB, JAMAIS a un signal du flipper :
#   P39  IO_L65P_INIT_B_2   INIT_B    (pull-up 4k7 vers 3V3)
#   P60  IO_L13P_M1_2       M1        ) M0=0, M1=0 -> Master SPI
#   P69  IO_L1N_M0_CMPMISO_2 M0       )
#   P144 IO_L1P_HSWAPEN_0   HSWAPEN   (niveau a arreter — voir AFFECTATION.md)
#
# Broches dediees, hors des 102 E/S (verifie dans le .tsv : banque = '-') :
#   P37 PROGRAM_B   P71 DONE   P72 CMPCS_B   P73 SUSPEND (a tirer a la masse)
#   P106 TDO  P107 TMS  P109 TCK  P110 TDI  -> en-tete JTAG
#
# E/S libres, gardees en reserve (6) :
#   P33   IO_L2P_3               banque 3
#   P34   IO_L1N_VREF_3          banque 3
#   P47   IO_L48N_RDWR_B_VREF_2  banque 2
#   P141  IO_L2N_0               banque 0
#   P142  IO_L2P_0               banque 0
#   P143  IO_L1N_VREF_0          banque 0
#==============================================================================
