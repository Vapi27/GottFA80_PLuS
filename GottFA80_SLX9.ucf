#   broches 1 (droite) -> 32 (gauche) : meme sens, aucun croisement.
#   La broche 35, extremite gauche de ce bord, porte NOR_CS_FPGA (section interne).
#------------------------------------------------------------------------------
NET "U6_PB<0>"                  LOC = "P1"    | IOSTANDARD = LVCMOS33;   # P3.3      IO_L83N_VREF_3  (bq 3)
NET "U6_PA<4>"                  LOC = "P2"    | IOSTANDARD = LVCMOS33;   # P3.4      IO_L83P_3  (bq 3)
NET "U6_PA<7>"                  LOC = "P5"    | IOSTANDARD = LVCMOS33;   # P3.5      IO_L52N_3  (bq 3)
NET "U6_PA<5>"                  LOC = "P6"    | IOSTANDARD = LVCMOS33;   # P3.6      IO_L52P_3  (bq 3)
NET "U4_PB<0>"                  LOC = "P7"    | IOSTANDARD = LVCMOS33;   # P3.7      IO_L51N_3  (bq 3)
NET "U5_PB_7"                   LOC = "P8"    | IOSTANDARD = LVCMOS33;   # P3.8      IO_L51P_3  (bq 3)
NET "U4_PB<2>"                  LOC = "P9"    | IOSTANDARD = LVCMOS33;   # P3.9      IO_L50N_3  (bq 3)
NET "U4_PB<1>"                  LOC = "P10"   | IOSTANDARD = LVCMOS33;   # P3.10     IO_L50P_3  (bq 3)
NET "U4_PB<4>"                  LOC = "P11"   | IOSTANDARD = LVCMOS33;   # P3.11     IO_L49N_3  (bq 3)
NET "U4_PB<3>"                  LOC = "P12"   | IOSTANDARD = LVCMOS33;   # P3.12     IO_L49P_3  (bq 3)
NET "U4_PB<6>"                  LOC = "P14"   | IOSTANDARD = LVCMOS33;   # P3.13     IO_L44N_GCLK20_3  (bq 3)
NET "U4_PB<5>"                  LOC = "P15"   | IOSTANDARD = LVCMOS33;   # P3.14     IO_L44P_GCLK21_3  (bq 3)
NET "U4_PA<0>"                  LOC = "P16"   | IOSTANDARD = LVCMOS33;   # P3.15     IO_L43N_GCLK22_IRDY2_3  (bq 3)
NET "U4_PB<7>"                  LOC = "P17"   | IOSTANDARD = LVCMOS33;   # P3.16     IO_L43P_GCLK23_3  (bq 3)
NET "U4_PA<2>"                  LOC = "P21"   | IOSTANDARD = LVCMOS33;   # P3.17     IO_L42N_GCLK24_3  (bq 3)
NET "U4_PA<1>"                  LOC = "P22"   | IOSTANDARD = LVCMOS33;   # P3.18     IO_L42P_GCLK25_TRDY2_3  (bq 3)
NET "U4_PA<4>"                  LOC = "P23"   | IOSTANDARD = LVCMOS33;   # P3.19     IO_L41N_GCLK26_3  (bq 3)
NET "U4_PA<3>"                  LOC = "P24"   | IOSTANDARD = LVCMOS33;   # P3.20     IO_L41P_GCLK27_3  (bq 3)
NET "U4_PA<6>"                  LOC = "P26"   | IOSTANDARD = LVCMOS33;   # P3.21     IO_L37N_3  (bq 3)
NET "U4_PA<5>"                  LOC = "P27"   | IOSTANDARD = LVCMOS33;   # P3.22     IO_L37P_3  (bq 3)
